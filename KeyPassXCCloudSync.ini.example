; KeyPassXC Cloud Sync 7.1.15 — example only; the GUI creates the actual configuration.
; Do not edit INI by hand for ordinary setup.
[General]
LocalFile = D:\Passwords\Passwords.kdbx
StateFile = D:\KeePassSync-Data\state.json
TrayEnabled = true
SyncEnabled = false

[Sync]
PollSeconds = 60
StatsPublishMinutes = 60
DebounceMs = 1500
StableFileCheckMs = 1200
RetrySeconds = 60

[Notifications]
OfflineAfterMinutes = 30

[Backup]
MinCopies = 20
MinDays = 30
; Local backup created at startup (not cloud history).
OnStartup = false
KeepStartupCopies = 30

[Logging]
Level = Info
MaxSizeMB = 5
MaxFiles = 5

[UI]
Language = auto
Theme = Системная
RememberWindowPosition = false

[Cloud.GooglePersonal]
Enabled = true
Provider = GoogleDrive
RemoteDirectory = KeePassSync
PollSeconds = 60
RefreshCredential = KeePassSync/Google/UNIQUE-CREDENTIAL-TARGET-A/refresh-token
; AccountLabel is filled by the GUI after OAuth
TimeoutSeconds = 120
GoogleFolderCacheSeconds = 10

[Cloud.GoogleWork]
Enabled = true
Provider = GoogleDrive
RemoteDirectory = KeePassSync
PollSeconds = 60
RefreshCredential = KeePassSync/Google/UNIQUE-CREDENTIAL-TARGET-B/refresh-token
; AccountLabel is filled independently by the GUI after OAuth
TimeoutSeconds = 120
GoogleFolderCacheSeconds = 10

; Each cloud has its own PollSeconds. CloudId is generated by the GUI and must remain unique.
; S3 Storage: Cloudflare R2 example (same configuration model for S3-compatible providers).
; [Cloud.S3Replica]
; Enabled = true
; Provider = S3
; RemoteDirectory = KeePassSync
; PollSeconds = 300
; BaseUrl = https://ACCOUNT_ID.r2.cloudflarestorage.com
; RootPath = keepass-sync
; S3Region = auto
; CredentialTarget = KeePassSync/S3/UNIQUE-CREDENTIAL-TARGET
; TimeoutSeconds = 120
; Access Key ID and Secret Access Key are stored exclusively in Windows Credential Manager.
;
; For AWS S3 or another compatible service, adjust BaseUrl, RootPath and S3Region.
; BaseUrl = https://s3.eu-central-1.amazonaws.com
; RootPath = my-keepass-sync
; S3Region = eu-central-1
